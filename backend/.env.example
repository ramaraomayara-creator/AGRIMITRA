# AgriMitra backend — copy to backend/.env (NEVER commit .env)
Market primary source: AGMARKNET 2.0 is keyless. Optional fallbacks below use server-side keys only.

PORT=5000
FRONTEND_URL=http://localhost:5173

# --- Market sources ---
AGMARKNET_API_URL=https://api.agmarknet.gov.in/v1
CEDA_API_URL=https://api.ceda.ashoka.edu.in
CEDA_API_KEY=

# --- Government OGD fallback (optional) ---
# Primary key name (use this one):
DATA_GOV_API_KEY=
# Legacy alias (also accepted):
MARKET_API_KEY=
MARKET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
MARKET_DATASET_URL=https://data.gov.in/resource/current-daily-price-various-commodities-various-markets-mandi

# --- Images (Wikimedia Commons needs NO key; optional provider below) ---
IMAGE_API_URL=https://commons.wikimedia.org/w/api.php
IMAGE_API_KEY=

# --- Weather (Open-Meteo: keyless current + forecast) ---
# No WEATHER_API_KEY is required.
# WEATHER_API_URL is not used by the default Open-Meteo service.

# --- Unused unless you add a database later ---
DATABASE_URL=

# --- Cache TTLs (seconds) ---
CACHE_TTL=900
IMAGE_CACHE_TTL=86400
